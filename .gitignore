# Ignore everything in the root directory by default
/*

# Allow specific files in the root directory
!.gitignore
!README.md
!PrepMaster.apk
!render.yaml

# Allow git to traverse into these folders, but ignore their other contents
!/backend/
!/frontend/

!/OneDrive/
/OneDrive/*

!/OneDrive/Desktop/
/OneDrive/Desktop/*

# Allow the Mobile App directory and all its contents
!/OneDrive/Desktop/Mobile App/

# Ignore build artifacts and node_modules inside Mobile App
OneDrive/Desktop/Mobile App/node_modules/
OneDrive/Desktop/Mobile App/android/app/build/
OneDrive/Desktop/Mobile App/android/.gradle/
OneDrive/Desktop/Mobile App/android/local.properties
OneDrive/Desktop/Mobile App/android/capture.png
